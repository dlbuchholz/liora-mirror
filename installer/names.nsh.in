; Generated by CMake from installer/names.nsh.in: the names the installers use, set in
; CMakeLists.txt. Passed to makensis as -DNAMES=<build folder>/generated/names.nsh.

; The program, its folder, .exe and settings
!define NAME "@PROJECT_NAME@"
; Its earlier name, whose installation the installers remove; empty when there was none
!define PREVIOUS_NAME "@APP_PREVIOUS_NAME@"
; QSettings' organization: the settings are in Software\<organization>\<name>
!define ORGANIZATION "@APP_ORGANIZATION@"
