#ifndef APPNAME_H
#define APPNAME_H

// Generated by CMake from src/appname.h.in. The program's name, for everything that shows it:
// the first word of project(<name> VERSION ...) in CMakeLists.txt. Its own header, apart from
// version.h, whose commit changes with every configure, so a new commit doesn't rebuild the
// files that only show the name.
#define APP_NAME "@PROJECT_NAME@"

// The program's earlier name, whose data and settings it takes over (namemigration.h); empty
// when there was none. Set in CMakeLists.txt.
#define APP_PREVIOUS_NAME "@APP_PREVIOUS_NAME@"

// QSettings' organization, set in CMakeLists.txt. Not set on the application, so the app data
// folder is just APP_NAME.
#define APP_ORGANIZATION "@APP_ORGANIZATION@"

#endif // APPNAME_H
